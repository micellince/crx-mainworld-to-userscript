{
  "name": "crx-to-userscript",
  "version": "1.3.0",
  "description": "Convert Chrome MV3 extensions into standalone Tampermonkey/Violentmonkey userscripts, with byte-level payload verification and a generic 4-stage sandbox verifier.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "crx2user": "./src/cli.mjs",
    "crx-to-userscript": "./src/cli.mjs"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "scripts": {
    "convert:fixture": "node src/cli.mjs convert tests/fixtures/generic-mv3-ext -o dist/generic-companion.user.js --verify",
    "build:futmarket": "node src/cli.mjs convert ../backups/v0.16.5/fc27-enhancer-ext -o dist/futmarket-app-v0.16.5.user.js --update-url https://futmarket.app/releases/futmarket-app.user.js --download-url https://futmarket.app/releases/futmarket-app.user.js --verify",
    "verify:futmarket": "node src/cli.mjs verify dist/futmarket-app-v0.16.5.user.js --source ../backups/v0.16.5/fc27-enhancer-ext",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "userscript",
    "tampermonkey",
    "violentmonkey",
    "greasemonkey",
    "converter",
    "main-world",
    "cors-bridge",
    "importscripts",
    "chrome-extension-to-userscript",
    "mv3",
    "llm",
    "ai-agents",
    "llms-txt"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/micellince/crx-to-userscript.git"
  },
  "homepage": "https://github.com/micellince/crx-to-userscript",
  "bugs": {
    "url": "https://github.com/micellince/crx-to-userscript/issues"
  }
}
